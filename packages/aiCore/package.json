{
  "name": "@cherrystudio/ai-core",
  "version": "2.0.1",
  "description": "Cherry Studio AI Core - Unified AI Provider Interface Based on Vercel AI SDK",
  "keywords": [
    "ai",
    "anthropic",
    "cherry-studio",
    "google",
    "openai",
    "sdk",
    "vercel-ai-sdk"
  ],
  "homepage": "https://github.com/CherryHQ/cherry-studio#readme",
  "bugs": {
    "url": "https://github.com/CherryHQ/cherry-studio/issues"
  },
  "license": "MIT",
  "author": "Cherry Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CherryHQ/cherry-studio.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./built-in/plugins": {
      "types": "./dist/built-in/plugins/index.d.ts",
      "react-native": "./dist/built-in/plugins/index.js",
      "import": "./dist/built-in/plugins/index.mjs",
      "require": "./dist/built-in/plugins/index.js",
      "default": "./dist/built-in/plugins/index.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "react-native": "./dist/provider/index.js",
      "import": "./dist/provider/index.mjs",
      "require": "./dist/provider/index.js",
      "default": "./dist/provider/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsc -w",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsrs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/azure": "^3.0.54",
    "@ai-sdk/deepseek": "^2.0.57",
    "@ai-sdk/openai-compatible": "^2.0.37",
    "@ai-sdk/provider": "^3.0.8",
    "@ai-sdk/xai": "^3.0.83",
    "@cherrystudio/ai-sdk-provider": "workspace:*",
    "@openrouter/ai-sdk-provider": "^2.3.3",
    "lru-cache": "^11.2.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cherrystudio/ai-sdk-provider": "workspace:*",
    "biome": "^0.3.3",
    "oxlint": "^1.93.0",
    "tsdown": "^0.20.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "ai": "^6.0.116"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
